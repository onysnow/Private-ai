# Standalone mode uses SQLite by default. Put real credentials in backend/.env or environment variables;
# do not commit them to source control.
DATABASE_URL=sqlite:///./journalism.db
APP_ENVIRONMENT=development
DOCUMENT_STORAGE_DIR=./data/documents
MAX_DOCUMENT_BYTES=52428800
ENABLE_PDF_OCR=true
PDF_OCR_LANGUAGE=eng
PDF_OCR_DPI=200
PDF_OCR_MIN_NATIVE_CHARS=20
MAX_BACKUP_BYTES=262144000
MAX_BACKUP_UNCOMPRESSED_BYTES=1073741824
MAX_BACKUP_FILES=10000
MAX_ZIP_COMPRESSION_RATIO=250
ENABLE_RESTORE_API=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8000,http://localhost:8000
API_AUTH_TOKEN=
# Optional comma-separated allowlist for the shared remote bearer token. Blank preserves unrestricted legacy shared-token access.
API_AUTH_INVESTIGATION_IDS=

ALEPH_BASE_URL=https://aleph.occrp.org
ALEPH_API_KEY=

# Integrated local OpenAleph corpus platform. Docker Compose enables this automatically.
OPENALEPH_ENABLED=false
OPENALEPH_BASE_URL=http://127.0.0.1:8001
OPENALEPH_UI_URL=http://127.0.0.1:8080
OPENALEPH_API_KEY=
OPENALEPH_AUTO_SYNC_DOCUMENTS=false
# Standalone fallback only. Integrated Docker mode disables this so ftm-analyze owns generic entity extraction.
ENABLE_LOCAL_ENTITY_SUGGESTIONS=true
OPENALEPH_TAG=5.3.1
OPENALEPH_SECRET_KEY=journalism-openaleph-dev
OPENALEPH_ES_JAVA_OPTS=-Xms1g -Xmx1g
OPENSANCTIONS_BASE_URL=https://api.opensanctions.org
OPENSANCTIONS_API_KEY=
OPENSANCTIONS_DATASET=default
OPENSANCTIONS_SEARCH_LIMIT=20

# Docker-only local database password. Change this before exposing services beyond localhost.
POSTGRES_PASSWORD=journalism-local-dev

# Core preview does not require AI. Keep disabled until the local investigator layer is ready.
ENABLE_AI_FEATURES=false
